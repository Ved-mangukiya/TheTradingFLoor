# ==============================================================================
# THE TRADING FLOOR CHAMPIONSHIP 2026 — ENVIRONMENT CONFIGURATION
# ==============================================================================
# All parameters have safe institutional defaults in server.js.
# This simulation is 100% offline-ready and requires NO external API keys or cloud services.
# Copy this file to .env only if you wish to override default server parameters.

# Network port for HTTP and WebSocket listeners (Default: 3000)
PORT=3000

# Default simulation mode: 'live' (event-day blue-chips) or 'test' (dry-run mock stocks)
SCENARIO_MODE=live

# Rate limit window in milliseconds between consecutive trades per team (Default: 200ms)
ORDER_RATE_LIMIT_MS=200

# Directory paths (Relative or Absolute)
DATA_DIR=data
LOGS_DIR=logs
